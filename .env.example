# Environment variables for local development and Vercel
# Copy this file to .env.local for local development.
# In Vercel, add the same keys under Project Settings -> Environment Variables.

# Public application URL.
# Local example: http://localhost:3000
# Production example: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq-compatible OpenAI SDK configuration used by src/lib/openai.ts
OPENAI_API_KEY=

# Polar.sh
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
